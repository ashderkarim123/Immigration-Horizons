      "clientVisible",
      "createdAt",
      "createdBy",
      "createdByName",
      "employeeAttendees",
      "endAt",
      "endDate",
      "eventType",
      "internalDescription",
      "internalTitle",
      "location",
      "meetingUrl",
      "startAt",
      "startDate",
      "status",
      "timeZone",
      "updatedAt",
      "updatedBy",
      "updatedByName",
      "workspace"
    ]
  },
  "eventTypes": [
    "appointment",
    "consultation",
    "interview",
    "biometrics",
    "meeting",
    "deadline",
    "milestone",
    "other"
  ],
  "eventStatuses": [
    "scheduled",
    "completed",
    "cancelled"
  ],
  "limits": {
    "internalTitle": 200,
