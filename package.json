    "db:indexes:dry-run": "node --conditions=react-server --import tsx scripts/createIndexes.ts --dry-run",
    "mail:check": "node --conditions=react-server --import tsx scripts/checkMail.ts",
    "og:generate": "node --conditions=react-server --import tsx scripts/generateOgImage.tsx",
    "db:migrate": "node --conditions=react-server --import tsx scripts/migrate.ts",
    "db:purge": "node --conditions=react-server --import tsx scripts/purgeRetention.ts"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.4.2",
    "file-type": "^22.0.1",
    "lucide-react": "^1.26.0",
    "mongoose": "^9.8.0",
    "next": "16.2.11",
    "nodemailer": "^9.1.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resend": "^6.18.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.11",
    "mongodb-memory-server": "^11.2.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  }
