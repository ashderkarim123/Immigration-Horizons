# =============================================================================
# Next.js app (public marketing site + client portal + staff console)
#
# Copy to `.env` and fill in. DEPLOYMENT.md Part 2 explains every variable;
# this file is the checklist you actually work through.
#
# Neither application validates these at boot — a missing value degrades
# silently rather than crashing, which is why the "Required?" column matters.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
NODE_ENV=production
PORT=3000

# --- Hosts -------------------------------------------------------------------
# REQUIRED. The host the PORTAL and STAFF console are served from (ADR-008).
# Two things read it, and a wrong value breaks both:
#   1. the CSRF Origin check on every mutating /api/portal/* and /api/staff/*
#      route — a mismatch 403s every client and staff write;
#   2. the activation and password-reset links in outgoing email.
# Unset, it falls back to http://localhost:3000 and nothing mutating works.
SITE_URL=https://app.immigrationhorizons.com

# The PUBLIC marketing host. Feeds canonical URLs, Open Graph and sitemap.
# Not the same value as SITE_URL above.
NEXT_PUBLIC_SITE_URL=https://immigrationhorizons.com
SITE_DOMAIN=immigrationhorizons.com

# --- Database ----------------------------------------------------------------
# REQUIRED. Without it leads still email but are never saved — silent data loss.
# Shared with server/.env; both apps use the same cluster and database.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/immigration-horizons?retryWrites=true&w=majority

# --- Mail (ADR-013) ----------------------------------------------------------
# Pick ONE transport. `resend` or `smtp`; omit or set `auto` to infer it from
# whichever credentials are present (Resend wins if both are set).
#
# Verify before go-live with:  npm run mail:check -- --send you@example.com
# Until that passes, invitations, activation links and password resets fail
# silently — they log a warning and never throw, by design.
MAIL_TRANSPORT=resend

# The address every outgoing message is sent from. Must be on a domain you
# have verified with the provider, or mail lands in spam (or is rejected).
EMAIL_FROM=Immigration Horizons <notifications@immigrationhorizons.com>

# Where lead notifications land.
CONTACT_RECEIVER_EMAIL=info@immigrationhorizons.com

# Where replies land. EMAIL_FROM above is a sending identity, not a mailbox
# — on a transactional subdomain nobody reads it, so a client hitting Reply
# on "your document was accepted" would be writing into a void. Point this
# at a real inbox, or an alias that delivers to one.
#
# Lead notifications override it per-message with the lead's own address, so
# staff can answer an enquiry directly. Everything else uses this.
MAIL_REPLY_TO=info@immigrationhorizons.com

# --- Mail: Resend transport --------------------------------------------------
# Required when MAIL_TRANSPORT=resend. Verify a sending domain in Resend
# first — the shared onboarding@resend.dev sender is for testing only.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Mail: SMTP transport ----------------------------------------------------
# Required when MAIL_TRANSPORT=smtp. Works with Google Workspace, Zoho,
# Microsoft 365, Amazon SES, or a hosting mailbox.
#
# Do NOT point this at a mail server running on the VPS itself: consumer and
# business mail providers reject or spam-folder mail from unknown VPS IP
# ranges. Use a real relay provider even when the transport is SMTP.
#
# Port 465 = implicit TLS, 587 = STARTTLS (the usual choice). SMTP_SECURE is
# inferred from the port; set it only to override that.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=notifications@immigrationhorizons.com
# SMTP_PASSWORD=an-app-specific-password
# SMTP_SECURE=false

# --- Break-glass admin login -------------------------------------------------
# Fallback credentials only. DB-backed users under /admin/users are the real
# auth path. Prefer ADMIN_PASSWORD_HASH over plaintext:
#   node -e "console.log(require('bcryptjs').hashSync('yourRealPassword', 12))"
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
SESSION_SECRET=generate-with-node-crypto-randomBytes-48-hex

# --- Scheduling --------------------------------------------------------------
# IANA zone defining "today" for the scheduled-consultation queues. Set the
# SAME value in server/.env, or the two apps disagree about which
# consultations are today. A fixed-offset abbreviation like EST is rejected.
APP_TIMEZONE=America/New_York

# --- Public contact details (safe to expose in the client bundle) ------------
NEXT_PUBLIC_CONTACT_EMAIL=info@immigrationhorizons.com
NEXT_PUBLIC_WHATSAPP_NUMBER_1=
NEXT_PUBLIC_WHATSAPP_NUMBER_2=
WHATSAPP_NUMBER_1=
WHATSAPP_NUMBER_2=

# --- Google Sheets sync ------------------------------------------------------
# NOT implemented in this stack — only the legacy site syncs to Sheets.
# These are read solely to render a status string in the admin CMS.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=

# --- Analytics (optional) ----------------------------------------------------
# Marketing site only. Never add an analytics or session-recording script to
# the portal or staff console — see docs/security/DATA_RETENTION.md §6.
GA4_ID=
GTM_ID=
META_PIXEL_ID=
LINKEDIN_PARTNER_ID=
MICROSOFT_CLARITY_ID=

# --- Private document storage (REQUIRED in production) -----------------------
# Where client documents (passports, degrees, employment records) are stored.
# BOTH apps refuse to start in production without it — there is deliberately
# no default outside development, because the dev default is os.tmpdir() and
# /tmp is cleared on reboot.
#
# Must be an ABSOLUTE path, and must NOT be inside either app's public/
# directory (the app checks, and refuses to start if it is).
# Both apps must point at the SAME directory: either can serve a download.
PRIVATE_DOCUMENT_ROOT=/srv/immigration-horizons/shared/private-documents

# --- Document storage (optional overrides) -----------------------------------
# DOCUMENT_MAX_FILE_SIZE_BYTES=26214400
# DOCUMENT_MAX_FILES_PER_REQUEST=10
