<%
// Cycle 8 — operational queues (ADR-007 §4). Rendered above the content
// counts because this is what the team acts on day to day. Each tile links
// to the queue that resolves it; a zero tile is deliberately still shown so
// "nothing waiting" is a visible, trustworthy state rather than an absence.
const OPERATIONS_TILES = operations ? [
  { label: 'Cases without a PM',    n: operations.casesWithoutManager,      url: '/admin/cases',                        icon: 'user-slash',        tone: 'rose' },
  { label: 'Unanswered queries',    n: operations.unansweredQueries,        url: '/admin/queries',                      icon: 'comment-dots',      tone: 'orange' },
  { label: 'Awaiting scheduling',   n: operations.queriesAwaitingScheduling, url: '/admin/queries',                     icon: 'calendar-plus',     tone: 'blue' },
  { label: 'Documents to review',   n: operations.documentsAwaitingReview,  url: '/admin/documents',                    icon: 'file-signature',    tone: 'purple' },
  { label: 'Overdue doc requests',  n: operations.overdueDocumentRequests,  url: '/admin/documents',                    icon: 'exclamation-triangle', tone: 'rose' },
  { label: 'Unread client messages', n: operations.unreadClientMessages,    url: '/admin/cases',                        icon: 'envelope-open-text', tone: 'cyan' },
  { label: 'Filing within 30 days', n: operations.upcomingFilingDeadlines,  url: '/admin/cases',                        icon: 'calendar-check',    tone: 'gold' },
  { label: 'Stalled cases',         n: operations.stalledCases,             url: '/admin/cases',                        icon: 'hourglass-half',    tone: 'orange' },
  { label: 'Quarantined files',     n: operations.quarantinedDocuments,     url: '/admin/documents',                    icon: 'shield-alt',        tone: 'rose' },
] : [];
%>
<% if (operations) { %>
  <div class="page-header" style="margin-bottom:14px">
    <div>
      <h1>Operations</h1>
      <p class="page-subtitle">What needs attention right now</p>
    </div>
  </div>
  <div class="stats-grid" style="margin-bottom:28px">
    <% OPERATIONS_TILES.forEach(function(t) { %>
      <a class="stat-card" href="<%= t.url %>" style="text-decoration:none;color:inherit">
        <div class="stat-card-icon <%= t.tone %>"><i class="fas fa-<%= t.icon %>"></i></div>
        <div class="stat-card-value"><%= t.n %></div>
        <div class="stat-card-label"><%= t.label %></div>
      </a>
    <% }); %>
  </div>
<% } %>

<!-- Stats Grid -->
<div class="stats-grid">
  <div class="stat-card">
    <div class="stat-card-icon blue"><i class="fas fa-users"></i></div>
    <div class="stat-card-value"><%= stats.totalLeads || 0 %></div>
    <div class="stat-card-label">Total Leads</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon green"><i class="fas fa-user-plus"></i></div>
    <div class="stat-card-value"><%= stats.newLeadsToday || 0 %></div>
    <div class="stat-card-label">New Today</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon orange"><i class="fas fa-calendar-week"></i></div>
    <div class="stat-card-value"><%= stats.leadsThisMonth || 0 %></div>
    <div class="stat-card-label">Leads This Month</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon purple"><i class="fas fa-edit"></i></div>
    <div class="stat-card-value"><%= stats.blogPosts || 0 %></div>
    <div class="stat-card-label">Blog Posts</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon cyan"><i class="fas fa-check-circle"></i></div>
    <div class="stat-card-value"><%= stats.publishedPosts || 0 %></div>
    <div class="stat-card-label">Published</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon rose"><i class="fas fa-clock"></i></div>
    <div class="stat-card-value"><%= stats.draftPosts || 0 %></div>
    <div class="stat-card-label">Drafts</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon gold"><i class="fas fa-star"></i></div>
    <div class="stat-card-value"><%= stats.testimonials || 0 %></div>
    <div class="stat-card-label">Testimonials</div>
  </div>
  <div class="stat-card">
    <div class="stat-card-icon blue"><i class="fas fa-question-circle"></i></div>
    <div class="stat-card-value"><%= stats.faqs || 0 %></div>
    <div class="stat-card-label">FAQs</div>
  </div>
</div>

<div class="dashboard-grid">
  <!-- Recent Leads -->
  <div class="admin-card">
    <div class="admin-card-header">
      <h3>Recent Consultation Requests</h3>
      <a href="/admin/leads" class="btn btn-ghost btn-sm">View All</a>
    </div>
    <div class="admin-card-body no-padding">
      <% if (!recentLeads || !recentLeads.length) { %>
        <div class="empty-state">
          <i class="fas fa-inbox"></i>
          <p>No consultation requests yet.</p>
        </div>
      <% } else { %>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr><th>Name</th><th>Service</th><th>Status</th><th>Date</th></tr>
            </thead>
            <tbody>
              <% recentLeads.forEach(function(lead) { %>
                <tr class="clickable-row" data-href="/admin/leads/<%= lead._id %>">
                  <td><span class="cell-title"><%= lead.name %></span><span class="cell-email"><%= lead.email %></span></td>
                  <td><%= lead.service || '—' %></td>
                  <td><span class="badge badge-<%= lead.status || 'new' %>"><%= (lead.status || 'new').replace('_', ' ') %></span></td>
                  <td><%= new Date(lead.createdAt).toLocaleDateString() %></td>
                </tr>
              <% }); %>
            </tbody>
          </table>
        </div>
      <% } %>
    </div>
  </div>

  <!-- Quick Actions & Recent Posts -->
  <div>
    <div class="admin-card" style="margin-bottom:16px">
      <div class="admin-card-header"><h3>Quick Actions</h3></div>
      <div class="admin-card-body">
        <div class="quick-actions">
          <a href="/admin/blog/new" class="quick-action-item">
            <i class="fas fa-plus-circle"></i>
            <span>New Blog Post</span>
          </a>
          <a href="/admin/leads" class="quick-action-item">
            <i class="fas fa-inbox"></i>
            <span>View Leads</span>
          </a>
          <a href="/admin/seo" class="quick-action-item">
            <i class="fas fa-search"></i>
            <span>SEO Manager</span>
          </a>
          <a href="/admin/settings" class="quick-action-item">
            <i class="fas fa-cog"></i>
            <span>Settings</span>
          </a>
        </div>
      </div>
    </div>

    <div class="admin-card">
      <div class="admin-card-header">
        <h3>Recent Blog Posts</h3>
        <a href="/admin/blog" class="btn btn-ghost btn-sm">View All</a>
      </div>
      <div class="admin-card-body no-padding">
        <% if (!recentPosts || !recentPosts.length) { %>
          <div class="empty-state">
            <i class="fas fa-edit"></i>
            <p>No posts yet.</p>
          </div>
        <% } else { %>
          <div class="admin-table-wrap">
            <table class="admin-table">
              <thead><tr><th>Title</th><th>Status</th><th>Date</th></tr></thead>
              <tbody>
                <% recentPosts.forEach(function(post) { %>
                  <tr>
                    <td><span class="cell-title"><%= post.title %></span></td>
                    <td><span class="badge <%= post.published ? 'badge-published' : 'badge-draft' %>"><%= post.published ? 'Published' : 'Draft' %></span></td>
                    <td><%= new Date(post.createdAt).toLocaleDateString() %></td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
  document.querySelectorAll('.clickable-row').forEach(function(row) {
    row.addEventListener('click', function(e) {
      if (e.target.closest('a, button, form')) return;
      window.location.href = this.dataset.href;
    });
  });
});
</script>
