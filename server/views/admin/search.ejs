<div class="page-header">
  <div>
    <h1>Search results</h1>
    <p class="page-subtitle">Results for “<%= query %>”</p>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-header"><h2>Blog posts (<%= blogs.length %>)</h2></div>
  <div class="admin-card-body no-padding">
    <% if (!blogs.length) { %>
      <div class="empty-state" style="padding:24px"><p>No matches.</p></div>
    <% } else { %>
      <div class="admin-table-wrap"><table class="admin-table"><tbody>
        <% blogs.forEach(function(b) { %>
          <tr><td><a href="/admin/blog/<%= b._id %>/edit"><%= b.title %></a></td><td><%= b.published ? 'Published' : 'Draft' %></td></tr>
        <% }); %>
      </tbody></table></div>
    <% } %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-header"><h2>Leads (<%= leads.length %>)</h2></div>
  <div class="admin-card-body no-padding">
    <% if (!leads.length) { %>
      <div class="empty-state" style="padding:24px"><p>No matches.</p></div>
    <% } else { %>
      <div class="admin-table-wrap"><table class="admin-table"><tbody>
        <% leads.forEach(function(l) { %>
          <tr><td><a href="/admin/leads/<%= l._id %>"><%= l.name %></a></td><td><%= l.email %></td><td><%= l.status || '' %></td></tr>
        <% }); %>
      </tbody></table></div>
    <% } %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-header"><h2>Testimonials (<%= testimonials.length %>)</h2></div>
  <div class="admin-card-body no-padding">
    <% if (!testimonials.length) { %>
      <div class="empty-state" style="padding:24px"><p>No matches.</p></div>
    <% } else { %>
      <div class="admin-table-wrap"><table class="admin-table"><tbody>
        <% testimonials.forEach(function(t) { %>
          <tr><td><%= t.name %></td><td><%= t.status || '' %></td></tr>
        <% }); %>
      </tbody></table></div>
    <% } %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-header"><h2>FAQs (<%= faqs.length %>)</h2></div>
  <div class="admin-card-body no-padding">
    <% if (!faqs.length) { %>
      <div class="empty-state" style="padding:24px"><p>No matches.</p></div>
    <% } else { %>
      <div class="admin-table-wrap"><table class="admin-table"><tbody>
        <% faqs.forEach(function(f) { %>
          <tr><td><%= f.question %></td><td><%= f.category || '' %></td></tr>
        <% }); %>
      </tbody></table></div>
    <% } %>
  </div>
</div>
