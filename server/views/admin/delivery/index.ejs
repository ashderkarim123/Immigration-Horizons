<%
const STATE_LABELS = { drafting: 'Drafting', internal_review: 'Internal Review', client_review: 'Client Review', ready: 'Ready for Delivery', delivered: 'Delivered' };
function fmtDate(d) { return d ? new Date(d).toLocaleString() : '—'; }
%>
<div class="page-header">
  <div>
    <h1>Delivery Records</h1>
    <p class="page-subtitle">Final petition package status for every lead</p>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body no-padding">
    <% if (!records.length) { %>
      <div class="empty-state">
        <i class="fas fa-truck"></i>
        <h3>No delivery records yet</h3>
        <p>A delivery record is created automatically the first time you set a lead's delivery state from its detail page.</p>
      </div>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th>Lead</th><th>Delivery state</th><th>Method</th><th>Files</th><th>Delivered</th><th class="shrink">Actions</th></tr>
          </thead>
          <tbody>
            <% records.forEach(function(r) { %>
              <tr>
                <td><span class="cell-title"><%= r.lead ? r.lead.name : '—' %></span></td>
                <td><span class="badge badge-delivery-<%= r.state %>"><%= STATE_LABELS[r.state] %></span></td>
                <td><%= r.method %></td>
                <td><%= r.files.length %> file<%= r.files.length === 1 ? '' : 's' %></td>
                <td><%= r.deliveredAt ? fmtDate(r.deliveredAt) + ' by ' + r.deliveredBy : '—' %></td>
                <td class="cell-actions">
                  <% if (r.lead) { %>
                    <a href="/admin/leads/<%= r.lead._id %>" class="btn btn-sm btn-ghost" title="Open lead"><i class="fas fa-eye"></i></a>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
