<div class="page-header">
  <div>
    <h1>Admin Users</h1>
    <p class="page-subtitle"><%= users.length %> users</p>
  </div>
  <div class="page-actions">
    <% if (can('users.manage')) { %>
      <a href="/admin/users/new" class="btn btn-primary btn-sm"><i class="fas fa-plus"></i> New User</a>
    <% } %>
  </div>
</div>

<div class="admin-card">
  <div class="admin-card-body no-padding">
    <% if (!users.length) { %>
      <div class="empty-state">
        <i class="fas fa-user-shield"></i>
        <h3>No admin users in the database</h3>
        <p>You can still sign in with the environment credentials. Add DB users for named, role-based access.</p>
        <a href="/admin/users/new" class="btn btn-primary">Add User</a>
      </div>
    <% } else { %>
      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr><th>Name</th><th>Email</th><th>Role</th><th>Active</th><th class="shrink">Actions</th></tr>
          </thead>
          <tbody>
            <% users.forEach(function(u) { %>
              <tr>
                <td><span class="cell-title"><%= u.name %></span></td>
                <td><%= u.email %></td>
                <td><span class="badge badge-published"><%= (roleLabels && roleLabels[u.role]) || u.role %></span></td>
                <td><%= u.isActive ? '<i class="fas fa-check" style="color:#15803d"></i>' : '—' %></td>
                <td class="cell-actions">
                  <% if (can('users.delete') && String(u._id) !== String(adminUser.id || '')) { %>
                    <form action="/admin/users/<%= u._id %>?_method=DELETE" method="POST" onsubmit="return confirm('Delete this user?');" style="display:inline">
                      <button type="submit" class="btn btn-sm btn-danger" title="Delete"><i class="fas fa-trash"></i></button>
                    </form>
                  <% } %>
                </td>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } %>
  </div>
</div>
