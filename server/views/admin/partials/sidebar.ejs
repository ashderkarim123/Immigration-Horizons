<%
// Sidebar navigation for admin panel
const menuItems = [
  { label: 'Dashboard', icon: 'tachometer-alt', page: 'dashboard', url: '/admin', group: 'Workspace' },
  { label: 'Blog', icon: 'edit', page: 'blog', url: '/admin/blog', group: 'Website content' },
  { label: 'SEO Manager', icon: 'search-plus', page: 'seo', url: '/admin/seo', group: 'Website content' },
  { label: 'Testimonials', icon: 'star', page: 'testimonials', url: '/admin/testimonials', group: 'Website content' },
  { label: 'FAQs', icon: 'question-circle', page: 'faqs', url: '/admin/faqs', group: 'Website content' },
  { label: 'Services', icon: 'cogs', page: 'services', url: '/admin/services', group: 'Website content' },
  { label: 'Media Library', icon: 'images', page: 'media', url: '/admin/media', group: 'Website content' },
  { label: 'Settings', icon: 'cog', page: 'settings', url: '/admin/settings', capability: 'settings.manage', group: 'System' },
  { label: 'Users', icon: 'user-shield', page: 'users', url: '/admin/users', capability: 'users.manage', group: 'System' },
].filter(function(item) { return !item.capability || can(item.capability); });
%>
<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <a href="/admin" aria-label="Immigration Horizons — admin home">
      <%# Same asset as the marketing site's header (public/images/logo-header.png). %>
      <img src="/images/logo-header.png" alt="Immigration Horizons" class="brand-logo" width="551" height="320">
    </a>
    <p class="sidebar-brand-caption">Website &amp; platform administration</p>
  </div>

  <div class="sidebar-divider"></div>

  <nav class="sidebar-nav">
    <ul class="nav-list">
      <% var activeGroup = null; %>
      <% menuItems.forEach(function(item) { %>
        <% if (item.group !== activeGroup) { activeGroup = item.group; %>
          <li class="sidebar-section-label"><%= item.group %></li>
        <% } %>
        <li class="nav-item <%= currentPage === item.page ? 'active' : '' %>">
          <a href="<%= item.url %>" class="nav-link">
            <span class="nav-icon">
              <i class="fas fa-<%= item.icon %>"></i>
            </span>
            <span class="nav-label"><%= item.label %></span>
            <%
              var badgeCount = 0;
              if (item.badge === 'newLeadsCount') badgeCount = typeof newLeadsCount !== 'undefined' ? newLeadsCount : 0;
              else if (item.badge === 'unreadNotificationCount') badgeCount = typeof unreadNotificationCount !== 'undefined' ? unreadNotificationCount : 0;
            %>
            <% if (item.badge && badgeCount > 0) { %>
              <span class="nav-badge" id="<%= item.page %>-count"><%= badgeCount %></span>
            <% } %>
          </a>
        </li>
      <% }); %>
    </ul>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-divider"></div>
    <a href="/" class="nav-link" target="_blank" title="View Website">
      <span class="nav-icon"><i class="fas fa-external-link-alt"></i></span>
      <span class="nav-label">View Website</span>
    </a>
  </div>
</aside>
