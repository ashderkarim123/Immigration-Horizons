<%
// Sidebar navigation for admin panel
const menuItems = [
  { label: 'Dashboard', icon: 'tachometer-alt', page: 'dashboard', url: '/admin' },
  { label: 'Leads', icon: 'users', page: 'leads', url: '/admin/leads', badge: 'newLeadsCount' },
  { label: 'Cases', icon: 'briefcase', page: 'cases', url: '/admin/cases', capability: 'cases.view' },
  { label: 'Queries', icon: 'comment-dots', page: 'queries', url: '/admin/queries', capability: 'queries.view' },
  { label: 'Task Board', icon: 'clipboard-list', page: 'tasks', url: '/admin/tasks' },
  { label: 'Sprint Board', icon: 'flag', page: 'sprints', url: '/admin/sprints' },
  { label: 'Delivery', icon: 'truck', page: 'delivery', url: '/admin/delivery' },
  { label: 'Notifications', icon: 'bell', page: 'notifications', url: '/admin/notifications', badge: 'unreadNotificationCount' },
  { label: 'Blog', icon: 'edit', page: 'blog', url: '/admin/blog' },
  { label: 'SEO Manager', icon: 'search-plus', page: 'seo', url: '/admin/seo' },
  { label: 'Testimonials', icon: 'star', page: 'testimonials', url: '/admin/testimonials' },
  { label: 'FAQs', icon: 'question-circle', page: 'faqs', url: '/admin/faqs' },
  { label: 'Services', icon: 'cogs', page: 'services', url: '/admin/services' },
  { label: 'Media Library', icon: 'images', page: 'media', url: '/admin/media' },
  { label: 'Settings', icon: 'cog', page: 'settings', url: '/admin/settings', capability: 'settings.manage' },
  { label: 'Users', icon: 'user-shield', page: 'users', url: '/admin/users', capability: 'users.manage' },
].filter(function(item) { return !item.capability || can(item.capability); });
%>
<aside class="admin-sidebar">
  <div class="sidebar-brand">
    <a href="/admin">
      <img src="/images/logo.png" alt="Immigration Horizons" class="brand-logo">
    </a>
  </div>

  <div class="sidebar-divider"></div>

  <nav class="sidebar-nav">
    <ul class="nav-list">
      <% menuItems.forEach(function(item) { %>
        <li class="nav-item <%= currentPage === item.page ? 'active' : '' %>">
          <a href="<%= item.url %>" class="nav-link">
            <span class="nav-icon">
              <i class="fas fa-<%= item.icon %>"></i>
            </span>
            <span class="nav-label"><%= item.label %></span>
            <%
              var badgeCount = 0;
              if (item.badge === 'newLeadsCount') badgeCount = typeof newLeadsCount !== 'undefined' ? newLeadsCount : 0;
              else if (item.badge === 'unreadNotificationCount') badgeCount = typeof unreadNotificationCount !== 'undefined' ? unreadNotificationCount : 0;
            %>
            <% if (item.badge && badgeCount > 0) { %>
              <span class="nav-badge" id="<%= item.page %>-count"><%= badgeCount %></span>
            <% } %>
          </a>
        </li>
      <% }); %>
    </ul>
  </nav>

  <div class="sidebar-footer">
    <div class="sidebar-divider"></div>
    <a href="/" class="nav-link" target="_blank" title="View Website">
      <span class="nav-icon"><i class="fas fa-external-link-alt"></i></span>
      <span class="nav-label">View Website</span>
    </a>
  </div>
</aside>
