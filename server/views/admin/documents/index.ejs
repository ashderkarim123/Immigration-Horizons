<%
function fmtDate(d) { return d ? new Date(d).toLocaleDateString() : '—'; }
function isOverdue(r) { return r.dueDate && new Date(r.dueDate) < new Date() && ['open','uploaded','under_review','replacement_required'].includes(r.status); }
%>
<a href="/admin/cases/<%= caseDoc._id %>" class="btn btn-ghost btn-sm" style="margin-bottom:12px;display:inline-block"><i class="fas fa-arrow-left"></i> Back to Case</a>

<div class="page-header">
  <div>
    <h1>Documents — <%= caseDoc.caseNumber %></h1>
    <p class="page-subtitle"><%= caseDoc.title %></p>
  </div>
</div>

<% if (requests.length) { %>
<div class="admin-card">
  <div class="admin-card-header"><h3>Document Requests</h3></div>
  <div class="admin-card-body">
    <table class="admin-table">
      <thead><tr><th>Title</th><th>Category</th><th>Due</th><th>Status</th><% if (canManageRequests) { %><th></th><% } %></tr></thead>
      <tbody>
        <% requests.forEach(function(r) { %>
        <tr>
          <td><%= r.title %></td>
          <td><% var cat = categories.find(function(c){ return String(c._id) === String(r.category); }); %><%= cat ? cat.name : '—' %></td>
          <td><%= fmtDate(r.dueDate) %> <% if (isOverdue(r)) { %><span class="badge badge-danger">Overdue</span><% } %></td>
          <td><span class="badge"><%= r.status %></span></td>
          <% if (canManageRequests) { %>
          <td>
            <form action="/admin/document-requests/<%= r._id %>/cancel" method="POST" style="display:inline" onsubmit="return confirm('Cancel this request?');">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <button type="submit" class="btn btn-sm btn-ghost">Cancel</button>
            </form>
          </td>
          <% } %>
        </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
</div>
<% } %>

<% if (canManageRequests) { %>
<div class="admin-card">
  <div class="admin-card-header"><h3>Request a Document</h3></div>
  <div class="admin-card-body">
    <form action="/admin/cases/<%= caseDoc._id %>/document-requests" method="POST" class="form-grid">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="form-group"><label>Title</label><input type="text" name="title" class="form-control" required></div>
      <div class="form-group">
        <label>Category</label>
        <select name="categoryId" class="form-control" required>
          <% categories.forEach(function(c) { %><option value="<%= c._id %>"><%= c.name %></option><% }); %>
        </select>
      </div>
      <div class="form-group">
        <label>From</label>
        <select name="requestedFromMemberId" class="form-control" required>
          <% clientMembers.forEach(function(m) { %>
          <option value="<%= m._id %>"><%= m.clientUser ? (m.clientUser.firstName || m.clientUser.email) : 'Client' %></option>
          <% }); %>
        </select>
      </div>
      <div class="form-group"><label>Due date</label><input type="date" name="dueDate" class="form-control"></div>
      <div class="form-group full-width"><label>Instructions</label><textarea name="instructions" class="form-control" rows="2"></textarea></div>
      <div class="form-group full-width"><button type="submit" class="btn btn-sm btn-primary">Create Request</button></div>
    </form>
  </div>
</div>
<% } %>

<% if (canManageCategories) { %>
<div class="admin-card">
  <div class="admin-card-header"><h3>Add Category</h3></div>
  <div class="admin-card-body">
    <form action="/admin/cases/<%= caseDoc._id %>/categories" method="POST" class="form-inline">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="text" name="name" class="form-control" placeholder="Category name" required>
      <select name="visibility" class="form-control">
        <option value="client_visible">Client-visible</option>
        <option value="employees_only">Employees only</option>
      </select>
      <select name="allowedUploaderTypes" class="form-control">
        <option value="both">Client or employee</option>
        <option value="client">Client only</option>
        <option value="employee">Employee only</option>
      </select>
      <button type="submit" class="btn btn-sm btn-ghost">Add</button>
    </form>
  </div>
</div>
<% } %>

<% categories.forEach(function(category) { %>
<div class="admin-card">
  <div class="admin-card-header">
    <h3><%= category.name %> <span class="badge"><%= category.visibility === 'client_visible' ? 'Client-visible' : 'Employees only' %></span><% if (category.required) { %> <span class="badge badge-priority-high">Required</span><% } %></h3>
    <% if (canManageCategories) { %>
    <form action="/admin/categories/<%= category._id %>/disable" method="POST" onsubmit="return confirm('Disable this category?');">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <button type="submit" class="btn btn-sm btn-ghost">Disable</button>
    </form>
    <% } %>
  </div>
  <div class="admin-card-body">
    <% var docs = documentsByCategory[String(category._id)] || []; %>
    <% if (docs.length) { %>
    <table class="admin-table">
      <thead><tr><th>Name</th><th>Status</th><th>Uploaded</th><th></th></tr></thead>
      <tbody>
        <% docs.forEach(function(doc) { %>
        <tr>
          <td><a href="/admin/documents/<%= doc._id %>"><%= doc.displayName %></a></td>
          <td><span class="badge"><%= doc.status %></span></td>
          <td><%= fmtDate(doc.createdAt) %></td>
          <td><a href="/admin/documents/<%= doc._id %>/download" class="btn btn-sm btn-ghost">Download</a></td>
        </tr>
        <% }); %>
      </tbody>
    </table>
    <% } else { %>
    <p class="text-muted">No documents yet.</p>
    <% } %>

    <% if (canUpload) { %>
    <form action="/admin/cases/<%= caseDoc._id %>/documents" method="POST" enctype="multipart/form-data" class="form-inline" style="margin-top:12px">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <input type="hidden" name="categoryId" value="<%= category._id %>">
      <input type="file" name="file" required>
      <button type="submit" class="btn btn-sm btn-primary">Upload</button>
    </form>
    <% } %>
  </div>
</div>
<% }); %>
