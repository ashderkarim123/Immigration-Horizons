# =============================================================================
# Admin CMS (Express/EJS) — server/
#
# Copy to `server/.env` and fill in. This is a SEPARATE process from the
# Next.js app with its own .env; several variables share a name with the root
# app's but must hold DIFFERENT values. Those are called out below.
#
# In production this app REFUSES TO START if NODE_ENV, MONGODB_URI,
# SESSION_SECRET or ADMIN_PASSWORD are missing or left at their placeholders.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
# REQUIRED. Gates secure cookies, `trust proxy`, and the startup guards above.
NODE_ENV=production
PORT=4000

# --- Host --------------------------------------------------------------------
# The host THIS app is reachable at. NOT the same value as the root app's
# SITE_URL (which points at app.immigrationhorizons.com).
SITE_URL=https://admin.immigrationhorizons.com

# --- Database ----------------------------------------------------------------
# REQUIRED. Same cluster and database as the root app. Also backs the session
# store — without it sessions fall back to in-memory and break across restarts.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/immigration-horizons?retryWrites=true&w=majority

# --- Session -----------------------------------------------------------------
# REQUIRED, and must be a real random value:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=generate-with-node-crypto-randomBytes-48-hex

# --- Break-glass admin login -------------------------------------------------
# Fallback only; DB-backed users under /admin/users are the real auth path.
# Every use of this login is recorded as `env_fallback` in security_events
# (ADR-012) and should be reconciled against a known operator.
#
# Prefer the hash over the plaintext:
#   node -e "console.log(require('bcryptjs').hashSync('yourRealPassword', 12))"
ADMIN_USERNAME=change-me
ADMIN_PASSWORD=change-me
# ADMIN_PASSWORD_HASH=

# Raise only if a legitimate operator is being locked out by the IP limiter.
# This does NOT affect the per-account lockout (5 attempts / 15 min, ADR-012).
# LOGIN_RATE_LIMIT=10

# --- Mail (ADR-013) ----------------------------------------------------------
# This app sends invitations, document notifications, query replies and
# digests. It reads the SAME variable names as the root app but from THIS
# file, so both must be configured — check each separately:
#   cd server && npm run mail:check -- --send you@example.com
MAIL_TRANSPORT=resend
EMAIL_FROM=Immigration Horizons <notifications@immigrationhorizons.com>
CONTACT_RECEIVER_EMAIL=info@immigrationhorizons.com

# Required when MAIL_TRANSPORT=resend.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Required when MAIL_TRANSPORT=smtp. See the root .env.example for the full
# note on why this should point at a relay provider and never at a mail
# server running on the VPS itself.
# SMTP_HOST=smtp.your-provider.com
# SMTP_PORT=587
# SMTP_USER=notifications@immigrationhorizons.com
# SMTP_PASSWORD=an-app-specific-password
# SMTP_SECURE=false

# --- Scheduling --------------------------------------------------------------
# MUST match the root app's APP_TIMEZONE, or the two disagree about which
# consultations count as "today" in their scheduled queues.
APP_TIMEZONE=America/New_York

# --- Private document storage (REQUIRED in production) -----------------------
# Where client documents (passports, degrees, employment records) are stored.
# BOTH apps refuse to start in production without it — there is deliberately
# no default outside development, because the dev default is os.tmpdir() and
# /tmp is cleared on reboot.
#
# Must be an ABSOLUTE path, and must NOT be inside either app's public/
# directory (the app checks, and refuses to start if it is).
# Both apps must point at the SAME directory: either can serve a download.
PRIVATE_DOCUMENT_ROOT=/srv/immigration-horizons/shared/private-documents

# --- Google Sheets sync ------------------------------------------------------
# NOT implemented in this stack. Read only to render a status string on
# /admin/contact-form.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB_NAME=

# --- Public contact details (rendered into a few admin views) ----------------
WHATSAPP_NUMBER_1=
WHATSAPP_NUMBER_2=

# --- Analytics (optional, marketing site only) -------------------------------
GA4_ID=
META_PIXEL_ID=
LINKEDIN_PARTNER_ID=
MICROSOFT_CLARITY_ID=
